vulhub/samba/CVE-2017-7494           192.168.80.26  dmz       samba      445
# white belt — reflex set B: apps & admin panels
vulhub/drupal/CVE-2018-7600          192.168.80.27  dmz       web        80
vulhub/webmin/CVE-2019-15107         192.168.80.28  dmz       web        10000
vulhub/thinkphp/5-rce                192.168.80.29  dmz       web        80
# brown belt — configure, chain & auxiliary-driven
vulhub/tomcat/tomcat8                192.168.80.23  dmz       tomcat     8080    internal:172.16.80.20
vulhub/php/8.1-backdoor              192.168.80.24  dmz       web        80
vulhub/libssh/CVE-2018-10933         192.168.80.30  dmz       sshd       22
vulhub/supervisor/CVE-2017-11610     192.168.80.31  dmz       web        9001

